{
  "name": "lola-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LOLA — Cloudflare Worker + D1 (sync offline-first del catálogo)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute lola-db --remote --file ./schema.sql",
    "db:init:local": "wrangler d1 execute lola-db --local --file ./schema.sql",
    "db:migrate": "wrangler d1 execute lola-db --remote --file ./scripts/migrate.sql",
    "db:reset": "wrangler d1 execute lola-db --remote --file ./scripts/reset.sql",
    "db:reset:local": "wrangler d1 execute lola-db --local --file ./scripts/reset.sql",
    "db:recreate": "wrangler d1 execute lola-db --remote --file ./scripts/recreate.sql && npm run db:init",
    "db:recreate:local": "wrangler d1 execute lola-db --local --file ./scripts/recreate.sql && npm run db:init:local",
    "import": "tsx scripts/import-catalogo.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^3.90.0",
    "xlsx": "^0.18.5"
  }
}
